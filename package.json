{
  "name": "33-js-concepts",
  "version": "1.0.0",
  "description": "33 Concepts Every JS Developer Should Know",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "validate-links": "ts-node scripts/validate-links.ts",
    "prettier": "prettier --write '**/*.{ts,js,json,md}'",
    "prettier:check": "prettier --check '**/*.{ts,js,json,md}'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juninmd/33-js-concepts.git"
  },
  "keywords": [
    "JavaScript",
    "JS",
    "NodeJS",
    "Node",
    "33-concepts",
    "javascript-fundamentals"
  ],
  "author": {
    "name": "Leonardo Maldonado",
    "url": "https://github.com/leonardomso"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/juninmd/33-js-concepts/issues"
  },
  "homepage": "https://github.com/juninmd/33-js-concepts#readme",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "scripts/**/*.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  }
}
